{
  "name": "dsh-progress-narrator",
  "version": "0.4.0",
  "description": "Quiet progress narration for DeepSeek Harness 0.2, with native persistent settings and independent Reader compatibility.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./protocol": "./lib/protocol.js"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "src",
    "scripts",
    "tests",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "progress",
    "narration",
    "folding"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "compatibility": {
      "host": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/state.js && node --check lib/protocol.js && node --check lib/rules.js && node --check lib/client.js && node --check lib/config.js",
    "build": "node scripts/build-client.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/S-AN-Shu/dsh-progress-narrator.git"
  },
  "bugs": {
    "url": "https://github.com/S-AN-Shu/dsh-progress-narrator/issues"
  },
  "homepage": "https://github.com/S-AN-Shu/dsh-progress-narrator",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  }
}
